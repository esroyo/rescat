---
import { description, title } from '../common.ts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={ Astro.generator } />
        <meta name="description" content={ description } />
        <title>{ title }</title>
	</head>
	<body>
        <Header /> 
		<slot />
        <Footer />
	</body>
</html>
<style is:global>
:root {
  --pico-muted-background: #EAE3DB;
}

/* Base primary: #ce331d */

[data-theme=light],
:root:not([data-theme=dark]),
:host:not([data-theme=dark]) {
  --pico-text-selection-color: rgba(206, 51, 29, 0.25);

  --pico-primary: #ce331d;
  --pico-primary-background: #ce331d;
  --pico-primary-underline: rgba(206, 51, 29, 0.5);

  --pico-primary-hover: #a82918;
  --pico-primary-hover-background: #b72d1a;

  --pico-primary-focus: rgba(206, 51, 29, 0.5);
  --pico-primary-inverse: #fff;
}

@media only screen and (prefers-color-scheme: dark) {
  :root:not([data-theme]),
  :host:not([data-theme]) {
    --pico-text-selection-color: rgba(232, 103, 87, 0.1875);

    --pico-primary: #e86757;
    --pico-primary-background: #ce331d;
    --pico-primary-underline: rgba(232, 103, 87, 0.5);

    --pico-primary-hover: #f19a8e;
    --pico-primary-hover-background: #df452e;

    --pico-primary-focus: rgba(232, 103, 87, 0.375);
    --pico-primary-inverse: #fff;
  }
}

a:link,
a:hover,
a:active,
a:visited {
    color: var(--pico-primary);
    text-decoration: none;
}
a:hover {
    text-decoration: underline;
}

body {
    display: grid;
    grid-template-rows: fit-content(4rem) auto fit-content(4rem);
    grid-template-areas: "header" "main" "footer";
}
header {
    display: grid;
    grid-area: header;
    border-bottom: .2rem dotted var(--nc-bg-2);
}
main {
    display: grid;
    grid-area: main;
    margin: 0 10rem;
}
footer {
    display: grid;
    grid-area: footer;
};
</style>
<style lang="scss" is:global>
@use "@picocss/pico/scss/pico" with (
  $theme-color: "orange",
  $enable-semantic-container: true,
  $enable-classes: false,
  $modules: (
    // Layout
    "layout/document": true,
    "layout/landmarks": true,
    "layout/container": true,
    "layout/section": false,
    "layout/grid": true,
    "layout/overflow-auto": false,

    // Content
    "content/link": true,
    "content/typography": true,
    "content/embedded": false,
    "content/button": false,
    "content/table": false,
    "content/code": false,
    "content/figure": true,
    "content/misc": true,

    // Forms
    "forms/basics": false,
    "forms/checkbox-radio-switch": false,
    "forms/input-color": false,
    "forms/input-date": false,
    "forms/input-file": false,
    "forms/input-range": false,
    "forms/input-search": false,

    // Components
    "components/accordion": false,
    "components/card": false,
    "components/dropdown": false,
    "components/group": false,
    "components/loading": false,
    "components/modal": false,
    "components/nav": false,
    "components/progress": false,
    "components/tooltip": false,

    // Utilities
    "utilities/accessibility": true,
    "utilities/reduce-motion": false,
  )
);
</style>
