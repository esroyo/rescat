---
import { Image } from 'astro:assets';
import vaneCarmela from '../assets/vane-carmela.png';
---
<footer class="dual">
    <section>
    <h3>Crèdits</h3>
    <dl>
        <dt>Disseny original i desenvolupament tècnic</dt>
        <dd>Carmela Forés · <a href="https://www.instagram.com/la_fores/" target="_blank">@la_fores</a></dd>
        <dt>Il·lustració i gràfica</dt>
        <dd>Vane Julian · <a href="https://vanejulian.com/" target="_blank">www.vanejulian.com</a> · <a href="https://www.instagram.com/vanejulian_/" target="_blank">@vanejulian_</a></dd>
        <dt>Creació continguts del llibret de navegació</dt>
        <dd>Carmela Forés i Vane Julian</dd>
        <dt>Direcció d’art</dt>
        <dd>Vane Julian i Carmela Forés</dd>
    </dl>
    </section>
    <Image alt="Vane i Carmela" src={vaneCarmela} layout={'constrained'}  />
</footer>
<style>
    footer {
        margin-top: var(--pico-block-spacing-vertical);
        align-items: center;
        justify-items: center;
        background: var(--pico-primary-background);
        color: var(--pico-primary-inverse);
        h3,
        dl,
    a:link,
    a:hover,
    a:active,
    a:visited { color: inherit; }
</style>
<style is:global>
    a.constrast:hover .menu-icon path {
        fill: var(--pico-primary) !important;
    }
</style>
