---
import Logo from '../assets/rescat-title.svg';
import MenuIconContext from '../assets/menu-icon-context.svg';
import MenuIconTestimonis from '../assets/menu-icon-testimonis.svg';
---
<header>
    <nav>
        <ul>
            <li>
                <a href="/" id="logo">
                    <Logo width={'auto'} height={'4rem'} fill="currentColor" />
                </a>
            </li>
            <li class="subtitle">Una operació a mar oberta</li>
        </ul>
        <ul>
            <li><a href="/context" class="constrast" ><MenuIconContext class="menu-icon" width={'auto'} height={'1.25rem'} fill="currentColor" aria-hidden />Context</a></li>
            <li><a href="/testimonies" class="constrast"><MenuIconTestimonis class="menu-icon" width={'auto'} height={'1.25rem'} fill="currentColor" aria-hidden />Testimonis</a></li>
            <li>
                <details class="dropdown">
                    <summary>
                        Language
                    </summary>
                    <ul dir="rtl">
                        <li><a href="#">Catalan</a></li>
                    </ul>
                </details>
            </li>
        </ul>
    </nav>
</header>
<style>
#logo {
    color: #090b0b;
}
#logo:hover {
    color: var(--pico-primary);
}
a.constrast {
    display: inline-flex;
    align-items: center;
    gap: calc(0.5 * var(--pico-spacing));
}
nav ul:last-of-type {
    gap: var(--pico-spacing);
}
@media (max-width: 700px) {
  .subtitle { display: none; }
  nav {
      flex-wrap: wrap;
      justify-content: center;
  }
}
</style>
