---
import { Picture } from 'astro:assets';

interface Props {
    image: ImageMetadata;
    alt?: string;
    title: string;
    objectPosition?: string;
}

const { image, alt = '', title, objectPosition = 'center' } = Astro.props;
---

<section class="page-band">
    <Picture src={image} alt={alt} sizes="100vw" />
    <div class="page-band-overlay">
        <h1>{title}</h1>
    </div>
</section>

<style define:vars={{ objectPosition }}>
    .page-band {
        position: relative;
        width: 100vw;
        margin-left: calc(50% - 50vw);
        height: clamp(140px, 22vh, 240px);
        overflow: hidden;
    }

    .page-band :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: var(--objectPosition);
        display: block;
    }

    .page-band-overlay {
        position: absolute;
        inset: auto 0 0 0;
        padding: var(--pico-block-spacing-vertical) var(--pico-block-spacing-horizontal);
        background: linear-gradient(to top, rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0));
        color: #fff;
    }

    .page-band-overlay h1 {
        margin: 0;
        color: #fff;
        text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
    }

    @media (max-width: 700px) {
        .page-band {
            height: 140px;
        }
    }
</style>
